{
    "name": "ops-report-ai",
    "version": "0.1.0",
    "description": "Demostración de arquitectura sólida para reportes operativos en pymes — el problema de negocio define la solución, no al revés.",
    "private": true,
    "scripts": {
        "start": "node dist/main.js",
        "dev": "ts-node src/main.ts",
        "build": "tsc",
        "test": "jest",
        "test:unit": "jest test/unit",
        "test:integration": "jest test/integration",
        "lint": "eslint src/**/*.ts",
        "arch:deps": "depcruise --config .dependency-cruiser.cjs --output-type err src",
        "arch:metrics": "ajv validate -s config/metrics.schema.json -d config/metrics.yaml",
        "arch:adrs": "node scripts/check-adrs.js",
        "arch": "npm run arch:deps && npm run arch:metrics && npm run arch:adrs"
    },
    "keywords": [
        "arquitectura-hexagonal",
        "pymes",
        "reportes-operativos",
        "ia-responsable",
        "nestjs"
    ],
    "author": "Carlos David Robayo",
    "license": "MIT"
}